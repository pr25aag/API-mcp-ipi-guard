# ==========================================
# LLM Configuration
# ==========================================

# Options: mock | anthropic
LLM_PROVIDER=mock

# Required only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Claude model to use
ANTHROPIC_MODEL=claude-sonnet-5


# ==========================================
# Prompt Injection Guard
# ==========================================

# Local path or Hugging Face repo ID of your trained DeBERTa model.
# Leave empty to use the built-in heuristic guard.
GUARD_MODEL_PATH=

# Detection threshold
GUARD_THRESHOLD=0.5

# Options: block | sanitize
GUARD_ACTION=block


# ==========================================
# CORS
# ==========================================

# Comma-separated list of allowed frontend origins.
# Use * for development.
ALLOWED_ORIGINS=*


# ==========================================
# Agent Configuration
# ==========================================

# Maximum number of tool-call iterations
MAX_AGENT_STEPS=6